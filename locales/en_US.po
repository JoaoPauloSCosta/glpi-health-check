# Health Check plugin translation (en_US)
msgid ""
msgstr ""
"Project-Id-Version: Health Check\n"
"Language: en_US\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#, php-format
msgid "%"
msgstr "%"

#, php-format
msgid "% livre"
msgstr "% free"

#, php-format
msgid "%1$d de %2$d documento(s) verificado(s) sem arquivo físico."
msgstr "%1$d of %2$d checked document(s) have no physical file."

#, php-format
msgid "%1$d de %2$d servidor(es) de e-mail inacessível(is) a partir do servidor do GLPI."
msgstr "%1$d of %2$d mail server(s) unreachable from the GLPI server."

#, php-format
msgid "%1$d dia(s) %2$d h"
msgstr "%1$d day(s) %2$d h"

#, php-format
msgid "%1$d h %2$d min"
msgstr "%1$d h %2$d min"

#, php-format
msgid "%1$d mensagem(ns) pendente(s) na fila, %2$d em retentativa e %3$d rejeitada(s) definitivamente em 7 dias; a mais antiga aguarda há %4$s."
msgstr "%1$d message(s) pending in the queue, %2$d retrying and %3$d permanently rejected in 7 days; the oldest has been waiting for %4$s."

#, php-format
msgid "%1$d plugin(s) registrado(s), %2$d ativo(s), nenhum em estado anormal."
msgstr "%1$d plugin(s) registered, %2$d active, none in an abnormal state."

#, php-format
msgid "%1$d requisito(s) não atendido(s), sendo %2$d obrigatório(s)."
msgstr "%1$d requirement(s) not met, %2$d of them mandatory."

#, php-format
msgid "%1$d tarefa(s) terminaram com erro nos últimos %2$d dias (%3$d com 3 ou mais falhas)."
msgstr "%1$d task(s) ended with an error in the last %2$d days (%3$d with 3 or more failures)."

#, php-format
msgid "%1$s %2$s está fora do período de suporte do fornecedor desde %3$s."
msgstr "%1$s %2$s has been outside the vendor support period since %3$s."

#, php-format
msgid "%1$s %2$s é compatível com o GLPI."
msgstr "%1$s %2$s is compatible with GLPI."

#, php-format
msgid "%1$s de %2$s ativo(s) sem nenhum responsável (usuário, grupo, técnico ou grupo técnico)."
msgstr "%1$s of %2$s active asset(s) have no owner (user, group, technician or technician group)."

#, php-format
msgid "%1$s de %2$s itens exibidos."
msgstr "%1$s of %2$s items shown."

#, php-format
msgid "%1$s registro(s) órfão(s) em %2$d relacionamento(s)."
msgstr "%1$s orphan record(s) in %2$d relationship(s)."

#, php-format
msgid "%1$s registrou %2$d %3$s nas últimas 24 horas."
msgstr "%1$s logged %2$d %3$s in the last 24 hours."

#, php-format
msgid "%d arquivo(s) ou diretório(s) sensível(is) encontrado(s) no diretório da aplicação."
msgstr "%d sensitive file(s) or directory(ies) found in the application directory."

#, php-format
msgid "%d ação(ões) automática(s) ativa(s) em modo GLPI (dependem de usuários navegando)."
msgstr "%d automatic action(s) active in GLPI mode (they depend on users browsing)."

#, php-format
msgid "%d ação(ões) automática(s) com execuções acima de 5 minutos."
msgstr "%d automatic action(s) with runs longer than 5 minutes."

#, php-format
msgid "%d coletor(es) ativo(s) funcionando sem erros."
msgstr "%d active collector(s) working without errors."

#, php-format
msgid "%d configuração(ões) do PHP afetam o desempenho."
msgstr "%d PHP setting(s) affect performance."

#, php-format
msgid "%d configuração(ões) do servidor de banco requer(em) atenção."
msgstr "%d database server setting(s) need attention."

#, php-format
msgid "%d configuração(ões) insegura(s) encontrada(s)."
msgstr "%d insecure setting(s) found."

#, php-format
msgid "%d conta(s) padrão ainda utilizam a senha de instalação: %s."
msgstr "%d default account(s) still use the installation password: %s."

#, php-format
msgid "%d de %d itens exibidos."
msgstr "%d of %d items shown."

#, php-format
msgid "%d dias"
msgstr "%d days"

#, php-format
msgid "%d diretório(s) com problema de acesso."
msgstr "%d directory(ies) with access problems."

#, php-format
msgid "%d e-mail(s) recebido(s) não foram importados nos últimos 7 dias."
msgstr "%d received email(s) were not imported in the last 7 days."

#, php-format
msgid "%d erro(s) de conexão/autenticação registrados"
msgstr "%d connection/authentication error(s) recorded"

#, php-format
msgid "%d falha(s) de envio de e-mail registrada(s) nos últimos 7 dias."
msgstr "%d email sending failure(s) recorded in the last 7 days."

#, php-format
msgid "%d inconsistência(s) na árvore de entidades."
msgstr "%d inconsistency(ies) in the entity tree."

#, php-format
msgid "%d indicador(es) de desempenho do banco requer(em) atenção."
msgstr "%d database performance indicator(s) need attention."

#, php-format
msgid "%d min"
msgstr "%d min"

#, php-format
msgid "%d permissão(ões) excessivamente aberta(s)."
msgstr "%d overly open permission(s)."

#, php-format
msgid "%d plugin(s) com atualização disponível."
msgstr "%d plugin(s) with an update available."

#, php-format
msgid "%d plugin(s) em estado anormal."
msgstr "%d plugin(s) in an abnormal state."

#, php-format
msgid "%d ponto(s) de atenção na configuração da API REST."
msgstr "%d attention point(s) in the REST API configuration."

#, php-format
msgid "%d problema(s) encontrado(s) nas tabelas do banco."
msgstr "%d problem(s) found in the database tables."

#, php-format
msgid "%d problema(s) na configuração de envio de e-mails."
msgstr "%d problem(s) in the email sending configuration."

#, php-format
msgid "%d regra(s) ativa(s) com configuração incompleta."
msgstr "%d active rule(s) with incomplete configuration."

#, php-format
msgid "%d s"
msgstr "%d s"

#, php-format
msgid "%d tabela(s) com fragmentação relevante."
msgstr "%d table(s) with significant fragmentation."

#, php-format
msgid "%d tabela(s) diferem do esquema de referência do GLPI."
msgstr "%d table(s) differ from the GLPI reference schema."

#, php-format
msgid "%d tarefa(s) atrasada(s) ou nunca executada(s), embora o cron esteja funcionando."
msgstr "%d task(s) late or never executed, even though cron is working."

#, php-format
msgid "%d tarefa(s) essencial(is) ou de manutenção desativada(s)."
msgstr "%d essential or maintenance task(s) disabled."

#, php-format
msgid "%d tarefa(s) presa(s) no estado \"Em execução\" há mais de 1 hora."
msgstr "%d task(s) stuck in the \"Running\" state for more than 1 hour."

#, php-format
msgid "%d tipo(s) de migração estrutural pendente(s) no banco de dados."
msgstr "%d type(s) of pending structural migration in the database."

#, php-format
msgid "%d usuário(s) com acesso administrativo à configuração."
msgstr "%d user(s) with administrative access to the configuration."

#, php-format
msgid "%d usuários ativos podem alterar a configuração geral do GLPI."
msgstr "%d active users can change the general GLPI configuration."

#, php-format
msgid "%d índice(s) esperado(s) ausente(s)."
msgstr "%d expected index(es) missing."

#, php-format
msgid "%s%% do valor máximo utilizado; novas inserções falharão ao atingir o limite."
msgstr "%s%% of the maximum value used; new inserts will fail when the limit is reached."

msgid "(OPcache e limites web só são avaliados em execução pelo navegador.)"
msgstr "(OPcache and web limits are only evaluated when run from the browser.)"

msgid "(não definido)"
msgstr "(not set)"

msgid "A API REST está desativada."
msgstr "The REST API is disabled."

msgid "A API REST está habilitada com clientes restritos."
msgstr "The REST API is enabled with restricted clients."

#, php-format
msgid "A URL configurada (%1$s) difere da URL usada para acessar o GLPI (%2$s): links das notificações e de documentos podem apontar para o endereço errado. Ignore se o acesso passar por um proxy reverso com outro endereço."
msgstr "The configured URL (%1$s) differs from the URL used to access GLPI (%2$s): links in notifications and documents may point to the wrong address. Ignore this if access goes through a reverse proxy with a different address."

msgid "A URL configurada usa HTTPS, mas esta página foi acessada por HTTP: falta redirecionamento HTTP → HTTPS."
msgstr "The configured URL uses HTTPS, but this page was accessed over HTTP: the HTTP → HTTPS redirect is missing."

msgid "A configuração de envio de e-mails está adequada."
msgstr "The email sending configuration is adequate."

msgid "A configuração dos cookies de sessão do PHP não segue as recomendações de segurança."
msgstr "The PHP session cookie configuration does not follow security recommendations."

msgid "A consulta externa de versões está desativada e a ação automática \"checkupdate\" do GLPI não registrou nenhuma versão nova."
msgstr "External version checking is disabled and the GLPI \"checkupdate\" automatic action has not recorded any new version."

msgid "A conta padrão \"glpi\" (super-administrador, login conhecido) está ativa."
msgstr "The default \"glpi\" account (super-admin, well-known login) is active."

msgid "A evolução aparece a partir do segundo diagnóstico."
msgstr "Progress appears from the second diagnosis onward."

msgid "A instalação não recebeu as últimas correções publicadas."
msgstr "The installation has not received the latest published fixes."

msgid "A política de segurança de senhas está desativada: qualquer senha é aceita."
msgstr "The password security policy is disabled: any password is accepted."

msgid "A política de senhas locais está ativa e adequada."
msgstr "The local password policy is active and adequate."

msgid "A raiz do servidor web aponta para o diretório \"public/\": arquivos internos não são acessíveis."
msgstr "The web server root points to the \"public/\" directory: internal files are not accessible."

msgid "A raiz do servidor web não aponta para \"public/\" e os diretórios de dados/configuração estão dentro da área acessível pela web."
msgstr "The web server root does not point to \"public/\" and the data/configuration directories are inside the web-accessible area."

msgid "A raiz do servidor web não aponta para \"public/\", permitindo acesso direto a arquivos internos da aplicação."
msgstr "The web server root does not point to \"public/\", allowing direct access to internal application files."

msgid "A validação do certificado do servidor SMTP está desativada, permitindo interceptação."
msgstr "SMTP server certificate validation is disabled, allowing interception."

#, php-format
msgid "A verificação de integridade não é suportada para a versão de esquema \"%s\"."
msgstr "The integrity check is not supported for schema version \"%s\"."

#, php-format
msgid "A verificação não pôde ser concluída: %s"
msgstr "The check could not be completed: %s"

msgid "A versão do PHP foi alterada no servidor sem considerar os requisitos do GLPI."
msgstr "The PHP version was changed on the server without considering the GLPI requirements."

msgid "A versão do banco de dados não corresponde à versão dos arquivos do GLPI."
msgstr "The database version does not match the version of the GLPI files."

msgid "A versão do esquema não está registrada na configuração."
msgstr "The schema version is not recorded in the configuration."

#, php-format
msgid "A versão instalada (%1$s) é a mais recente do seu ramo. Existe uma versão principal mais nova: %2$s."
msgstr "The installed version (%1$s) is the latest in its branch. A newer major version exists: %2$s."

#, php-format
msgid "A versão instalada (%s) não é uma versão estável."
msgstr "The installed version (%s) is not a stable version."

msgid "A árvore de entidades está consistente."
msgstr "The entity tree is consistent."

msgid "API habilitada"
msgstr "API enabled"

msgid "API habilitada sem HTTPS: tokens de acesso trafegam sem criptografia."
msgstr "API enabled without HTTPS: access tokens travel unencrypted."

msgid "AUTO_INCREMENT próximo do limite"
msgstr "AUTO_INCREMENT near the limit"

msgid "Abra cada cliente listado e defina a faixa de IPs permitida e um App-Token."
msgstr "Open each listed client and set the allowed IP range and an App-Token."

msgid "Abra cada tarefa listada e altere o status para \"Agendada\"."
msgstr "Open each listed task and change its status to \"Scheduled\"."

msgid "Abre apenas uma conexão TCP com os servidores configurados (sem autenticação e sem envio de dados)."
msgstr "Opens only a TCP connection to the configured servers (no authentication and no data sent)."

msgid "Abrir diagnóstico"
msgstr "Open diagnosis"

msgid "Acertos no buffer pool"
msgstr "Buffer pool hits"

msgid "Acesse Administração > E-mails não importados (ou Configurar > Coletores > E-mails não importados)."
msgstr "Go to Administration > Not imported emails (or Setup > Receivers > Not imported emails)."

msgid "Acesse Administração > Regras e abra o tipo de regra indicado."
msgstr "Go to Administration > Rules and open the indicated rule type."

msgid "Acesse Administração > Usuários e abra cada conta listada."
msgstr "Go to Administration > Users and open each listed account."

msgid "Acesse Configurar > Ações automáticas."
msgstr "Go to Setup > Automatic actions."

msgid "Acesse Configurar > Coletores e abra o coletor indicado."
msgstr "Go to Setup > Receivers and open the indicated receiver."

msgid "Acesse Configurar > Geral > API."
msgstr "Go to Setup > General > API."

msgid "Acesse Configurar > Geral > Segurança."
msgstr "Go to Setup > General > Security."

msgid "Acesse Configurar > Notificações > Configuração das notificações por e-mail."
msgstr "Go to Setup > Notifications > Email notifications configuration."

msgid "Acesse Configurar > Plugins e use o botão de atualização do Marketplace."
msgstr "Go to Setup > Plugins and use the Marketplace update button."

msgid "Acesse Configurar > Plugins."
msgstr "Go to Setup > Plugins."

msgid "Acesso administrativo"
msgstr "Administrative access"

msgid "Acesso aos diretórios do GLPI"
msgstr "Access to GLPI directories"

msgid "Acesso atual"
msgstr "Current access"

msgid "Acessível"
msgstr "Accessible"

msgid "Acompanhamentos de chamados inexistentes"
msgstr "Non-existent ticket followups"

#, php-format
msgid "Adicione a linha: \"* * * * * php %s/front/cron.php\""
msgstr "Add the line: \"* * * * * php %s/front/cron.php\""

msgid "Agendadas para o futuro"
msgstr "Scheduled for the future"

msgid "Agendamento"
msgstr "Schedule"

#, php-format
msgid "Agende \"php %s/front/cron.php\" para executar a cada minuto no sistema operacional."
msgstr "Schedule \"php %s/front/cron.php\" to run every minute in the operating system."

msgid "Ainda não há diagnóstico anterior do mesmo tipo para comparar."
msgstr "There is no previous diagnosis of the same type to compare yet."

msgid "Ajuste as diretivas de sessão no php.ini (ou no pool do PHP-FPM) e reinicie o serviço."
msgstr "Adjust the session directives in php.ini (or in the PHP-FPM pool) and restart the service."

msgid "Ajuste dono e permissões para que o usuário do servidor web tenha leitura e escrita nos diretórios de dados."
msgstr "Adjust owner and permissions so that the web server user has read and write access to the data directories."

msgid "Ajuste memory_limit no php.ini (web e CLI) e avalie aumentar a memória do servidor."
msgstr "Adjust memory_limit in php.ini (web and CLI) and consider increasing the server memory."

msgid "Ajuste o tempo de retenção dos logs nas ações automáticas (\"logs\", \"queuednotificationclean\") e em Configurar > Geral > Logs."
msgstr "Adjust the log retention time in the automatic actions (\"logs\", \"queuednotificationclean\") and in Setup > General > Logs."

msgid "Ajuste os parâmetros do servidor de banco conforme a memória disponível e analise as consultas lentas."
msgstr "Adjust the database server parameters according to the available memory and analyze slow queries."

msgid "Ajuste os parâmetros no arquivo de configuração do servidor de banco (my.cnf / server.cnf) e reinicie o serviço em janela de manutenção."
msgstr "Adjust the parameters in the database server configuration file (my.cnf / server.cnf) and restart the service during a maintenance window."

msgid "Ajuste os parâmetros no php.ini usado pelo servidor web e reinicie o serviço."
msgstr "Adjust the parameters in the php.ini used by the web server and restart the service."

msgid "Alerta"
msgstr "Warning"

msgid "Alerta com mensagens pendentes na fila a partir de"
msgstr "Warn with pending messages in the queue from"

#, php-format
msgid "Alerta de disco livre abaixo de (%)"
msgstr "Free disk warning below (%)"

msgid "Alertas"
msgstr "Warnings"

msgid "Alta"
msgstr "High"

msgid "Alterações diretas no banco, importações ou exclusões interrompidas."
msgstr "Direct database changes, interrupted imports or deletions."

msgid "Alterações manuais no banco, atualização interrompida, restauração parcial de backup ou tabelas deixadas por plugins removidos."
msgstr "Manual database changes, interrupted update, partial backup restore or tables left by removed plugins."

msgid "Alterações manuais no banco, migrações incompletas ou restauração de estrutura antiga."
msgstr "Manual database changes, incomplete migrations or restore of an old structure."

msgid "Altere imediatamente as senhas ou desative/exclua as contas não utilizadas."
msgstr "Immediately change the passwords or disable/delete unused accounts."

msgid "Ambiente saudável"
msgstr "Healthy environment"

msgid "Amplie o volume ou mova files/ para um volume maior."
msgstr "Enlarge the volume or move files/ to a larger volume."

msgid "Analise cada diferença antes de qualquer correção. Tabelas desconhecidas normalmente são restos de plugins ou customizações."
msgstr "Review each difference before any fix. Unknown tables are usually leftovers from plugins or customizations."

msgid "Analise o histórico de cada tarefa e os logs do GLPI no horário das falhas."
msgstr "Review each task's history and the GLPI logs at the time of the failures."

msgid "Analise os erros recentes, ative a rotação de logs e configure a purga do histórico."
msgstr "Review recent errors, enable log rotation and configure history purging."

msgid "Analise os registros antes de qualquer limpeza; a correção deve ser feita com backup e preferencialmente em homologação."
msgstr "Review the records before any cleanup; the fix should be done with a backup and preferably in a staging environment."

msgid "Antes"
msgstr "Before"

msgid "Antes de atualizar o GLPI, desative os plugins sem versão compatível com a nova versão."
msgstr "Before updating GLPI, disable plugins that have no version compatible with the new version."

msgid "Anuncia a versão do PHP nos cabeçalhos HTTP, facilitando a escolha de ataques."
msgstr "Announces the PHP version in HTTP headers, making it easier to choose attacks."

#, php-format
msgid "Apache: \"DocumentRoot %s/public\" com AllowOverride All (ou as regras de rewrite da documentação)."
msgstr "Apache: \"DocumentRoot %s/public\" with AllowOverride All (or the rewrite rules from the documentation)."

msgid "Aplicação"
msgstr "Application"

msgid "Aplique o princípio do menor privilégio e use contas nominais para administração."
msgstr "Apply the principle of least privilege and use named accounts for administration."

msgid "Aponte o servidor web (PHP-FPM/módulo) e o cron para o mesmo binário PHP."
msgstr "Point the web server (PHP-FPM/module) and cron to the same PHP binary."

msgid "Aprovadas"
msgstr "Passed"

msgid "Aprovado"
msgstr "Passed"

msgid "Aproxime o banco do servidor de aplicação, use IP em vez de nome de host e verifique a carga do servidor de banco."
msgstr "Move the database closer to the application server, use an IP instead of a hostname and check the database server load."

msgid "Após backup, execute \"OPTIMIZE TABLE nome_da_tabela\" para as tabelas fragmentadas (bloqueia a tabela durante a execução)."
msgstr "After a backup, run \"OPTIMIZE TABLE table_name\" for the fragmented tables (locks the table while running)."

msgid "Após corrigir, o contador de erros é zerado na próxima coleta bem-sucedida."
msgstr "After fixing, the error counter is reset on the next successful collection."

msgid "Após essa data o PHP deixará de receber correções de segurança."
msgstr "After this date PHP will stop receiving security fixes."

msgid "Após o HTTPS, ative session.cookie_secure no PHP."
msgstr "After enabling HTTPS, enable session.cookie_secure in PHP."

msgid "Arquivo"
msgstr "File"

#, php-format
msgid "Arquivo .htaccess de proteção ausente em %s"
msgstr "Protective .htaccess file missing in %s"

msgid "Arquivos atualizados, aguardando atualização (plugin desativado até concluir)"
msgstr "Files updated, awaiting update (plugin disabled until completed)"

msgid "Arquivos ausentes"
msgstr "Missing files"

msgid "Arquivos de log"
msgstr "Log files"

msgid "Arquivos de plugins"
msgstr "Plugin files"

msgid "Arquivos deixados após instalação, testes, backups manuais ou deploy via repositório."
msgstr "Files left behind after installation, tests, manual backups or repository deploys."

msgid "Arquivos e diretórios sensíveis expostos"
msgstr "Sensitive files and directories exposed"

msgid "Arquivos e documentos"
msgstr "Files and documents"

msgid "Arquivos esquecidos podem permitir reinstalação, revelar a configuração do servidor ou vazar dados e credenciais."
msgstr "Forgotten files may allow reinstallation, reveal the server configuration or leak data and credentials."

msgid "As ações automáticas do plugin não foram encontradas. Reinstale o plugin para registrá-las."
msgstr "The plugin's automatic actions were not found. Reinstall the plugin to register them."

msgid "As ações automáticas estão sendo executadas regularmente."
msgstr "Automatic actions are being executed regularly."

msgid "As configurações críticas do servidor de banco estão adequadas."
msgstr "The critical database server settings are adequate."

msgid "As configurações de desempenho do PHP estão adequadas."
msgstr "The PHP performance settings are adequate."

msgid "As funções dessas tarefas (alertas, limpezas, SLAs, notificações) não estão sendo processadas no prazo."
msgstr "The functions of these tasks (alerts, cleanups, SLAs, notifications) are not being processed on time."

msgid "As senhas das contas criadas pela instalação nunca foram alteradas."
msgstr "The passwords of the accounts created by the installation were never changed."

msgid "As tarefas com falha não concluem seu trabalho: notificações, coletas, limpezas ou cálculos de SLA podem estar incompletos."
msgstr "Failed tasks do not complete their work: notifications, collections, cleanups or SLA calculations may be incomplete."

msgid "As tarefas em modo GLPI nunca foram executadas."
msgstr "Tasks in GLPI mode have never been executed."

msgid "As tarefas essenciais e de limpeza estão ativas."
msgstr "Essential and cleanup tasks are active."

msgid "Atenção necessária"
msgstr "Attention needed"

msgid "Atenção: diagnóstico executado em CLI; o usuário do cron pode ser diferente do usuário do servidor web."
msgstr "Warning: diagnosis run via CLI; the cron user may differ from the web server user."

msgid "Ativas em modo CLI"
msgstr "Active in CLI mode"

msgid "Ativas em modo GLPI"
msgstr "Active in GLPI mode"

msgid "Ative \"Política de segurança de senha\" e defina o tamanho mínimo."
msgstr "Enable \"Password security policy\" and set the minimum length."

msgid "Ative a ação automática \"circularlogs\" (rotação dos arquivos de log)."
msgstr "Enable the \"circularlogs\" automatic action (log file rotation)."

msgid "Ative a política de senhas com no mínimo 12 caracteres, ou centralize a autenticação em LDAP/SSO."
msgstr "Enable the password policy with at least 12 characters, or centralize authentication in LDAP/SSO."

msgid "Ative o slow query log (slow_query_log=ON, long_query_time=2) para identificar consultas lentas."
msgstr "Enable the slow query log (slow_query_log=ON, long_query_time=2) to identify slow queries."

msgid "Ativo"
msgstr "Active"

msgid "Ativos"
msgstr "Assets"

msgid "Ativos analisados"
msgstr "Assets analyzed"

msgid "Ativos criados por inventário automático sem regras de atribuição, ou cadastros incompletos."
msgstr "Assets created by automatic inventory without assignment rules, or incomplete records."

msgid "Ativos sem autorização"
msgstr "Assets without authorization"

msgid "Ativos sem responsáveis"
msgstr "Assets without owners"

msgid "Atores de chamados inexistentes"
msgstr "Non-existent ticket actors"

msgid "Atraso"
msgstr "Delay"

msgid "Atribua um perfil aos usuários ativos sem autorização ou desative-os."
msgstr "Assign a profile to active users without authorization or disable them."

msgid "Atualização do GLPI ou do PHP sem atualizar os plugins, ou plugins abandonados pelos autores."
msgstr "GLPI or PHP update without updating plugins, or plugins abandoned by their authors."

msgid "Atualização dos arquivos sem executar a atualização do plugin, ou remoção do diretório sem desinstalar."
msgstr "Files updated without running the plugin update, or directory removed without uninstalling."

msgid "Atualização e requisitos"
msgstr "Update and requirements"

msgid "Atualizações de plugins disponíveis"
msgstr "Available plugin updates"

msgid "Atualize \"URL da aplicação\" em Configurar > Geral > Configuração geral."
msgstr "Update \"URL of the application\" in Setup > General > General setup."

msgid "Atualize a senha/credenciais e prefira IMAP com SSL (porta 993)."
msgstr "Update the password/credentials and prefer IMAP with SSL (port 993)."

msgid "Atualize o servidor MySQL/MariaDB seguindo a documentação do fornecedor."
msgstr "Update the MySQL/MariaDB server following the vendor documentation."

msgid "Atualize o servidor de banco para uma versão suportada (MySQL >= 5.7 ou MariaDB >= 10.2, preferencialmente uma versão LTS atual)."
msgstr "Update the database server to a supported version (MySQL >= 5.7 or MariaDB >= 10.2, preferably a current LTS version)."

msgid "Atualize os plugins para versões compatíveis antes de atualizar o GLPI; desative os que não tiverem versão compatível."
msgstr "Update plugins to compatible versions before updating GLPI; disable those without a compatible version."

msgid "Atualize para um ramo do PHP com suporte ativo e compatível com o GLPI instalado."
msgstr "Update to an actively supported PHP branch that is compatible with the installed GLPI."

msgid "Atualize pelo Marketplace ou substituindo o diretório do plugin, e execute a atualização em Configurar > Plugins."
msgstr "Update through the Marketplace or by replacing the plugin directory, and run the update in Setup > Plugins."

